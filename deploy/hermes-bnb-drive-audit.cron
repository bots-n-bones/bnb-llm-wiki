SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Daily metadata-only recursive inventory of the canonical Drive root.
17 3 * * * root /usr/bin/flock -n /var/lock/hermes-bnb-drive-audit.lock /usr/bin/docker exec -u hermes hermes-codex-workspace-hermes-agent-1 /bin/sh /opt/knowledge/bnb-llm-wiki/scripts/run-drive-audit.sh >> /var/log/hermes-bnb-drive-audit.log 2>&1
